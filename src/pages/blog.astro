---
import PageLayout from "../layouts/PageLayout.astro";
import PageMeta from "../components/PageMeta.astro";
import PageIntro from "../components/PageIntro.astro";
import PostList from "../components/PostList.astro";
import { COLLECTION_PAGES, getPublishedPosts } from "../lib/posts";
import { SITE_TITLE } from "../config";

const posts = await getPublishedPosts("blog");
---

<PageLayout>
  <PageMeta title={`Writing | ${SITE_TITLE}`} slot="meta" />
  <PageIntro label={COLLECTION_PAGES.blog.label} title="Notes on building software and leading teams." />
  <PostList posts={posts} />
</PageLayout>
