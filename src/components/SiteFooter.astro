---
import { MY_NAME } from "../config";
import { CONTACT } from "../story/content";
---

<footer class="site-footer">
  <p class="label">© {new Date().getFullYear()} {MY_NAME}</p>
  <ul>
    <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
    {
      CONTACT.profiles.map((profile) => (
        <li>
          <a href={profile.href} rel="me noopener" target="_blank">
            {profile.label}
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 6rem;
    padding: 2rem var(--gutter) 2.5rem;
    border-top: 1px solid rgb(152 166 187 / 0.1);
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s;
  }
  a:hover,
  a:focus-visible {
    color: var(--text);
  }
</style>
