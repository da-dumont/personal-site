---
import { imageTransitionName } from "../lib/posts";

type Props = {
  src: string;
  alt: string;
};

const { src, alt } = Astro.props;
const { slug } = Astro.params;
---

<figure>
  <img src={src} alt={alt} style={slug ? `view-transition-name: ${imageTransitionName(slug)}` : undefined} />
</figure>
