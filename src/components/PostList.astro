---
import { formatPostDate, type Post } from "../lib/posts";

type Props = {
  posts: Post[];
  /** "book" shows small square covers instead of large round images. */
  imageStyle?: "round" | "book";
};

const { posts, imageStyle = "round" } = Astro.props;
const isBook = imageStyle === "book";
---

<section>
  <ul>
    {
      posts.map((post) => (
        <li class="post title">
          <a class="block" href={post.data.external ? post.data.url : `/${post.collection}/${post.id}`}>
            <div>
              <h3>{post.data.title}</h3>
              <time datetime={post.data.date.toISOString()} class="publish-date">
                {formatPostDate(post.data.date)}
              </time>
            </div>
            {post.data.previewImage && (
              <div class:list={["image-container", { "image-container-book": isBook }]}>
                <img
                  src={post.data.previewImage}
                  class:list={["preview-image", { "preview-image-book": isBook }]}
                  transition:name={post.id}
                />
              </div>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  ul {
    list-style-type: none;
    padding: unset;
  }

  .post {
    line-height: 1.5;
    margin: 0 0 4rem 0;
    padding: 0;
  }

  .post a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    column-gap: 20px;
  }

  .image-container {
    max-width: 200px;
    max-height: 200px;
  }
  .image-container-book {
    max-width: 100px;
    max-height: 100px;
  }

  .preview-image {
    border-radius: 50%;
    object-fit: contain;
  }
  .preview-image-book {
    border-radius: 0;
  }

  .post + .post {
    padding-top: 0.5rem;
  }
  .post h3 {
    margin: 0;
    font-size: 1.75rem;
  }

  .title a {
    color: var(--text);
    border-bottom: none;
  }

  .title a:hover {
    color: var(--text-link);
  }

  .publish-date {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-style: italic;
  }
</style>
