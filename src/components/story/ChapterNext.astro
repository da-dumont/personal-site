---
import StoryHeading from "./StoryHeading.astro";
import { next } from "../../story/content";
import { formatPostDate, getPublishedPosts } from "../../lib/posts";

/** The latest real posts; external links go where they point. */
const posts = (await getPublishedPosts("blog")).slice(0, 4).map((post) => ({
  title: post.data.title,
  date: post.data.date,
  description: post.data.external ? undefined : post.data.description,
  href: post.data.external ? post.data.url : `/blog/${post.id}`,
}));
---

<section id="next" class="chapter next" aria-labelledby="next-title" style="--track: 420vh">
  <div class="stage">
    <div class="next__phase next__exploring" data-next="exploring">
      <StoryHeading heading={next.heading} id="next-title">
        <p class="next__turn" data-next="turn" data-reveal>{next.turn}</p>
      </StoryHeading>
      <ul class="exploring" aria-label="What I'm exploring">
        {next.exploring.map((item) => <li data-next-item data-reveal>{item}</li>)}
      </ul>
    </div>

    <div class="next__phase writing" data-next="writing" data-reveal>
      <p class="label writing__label">{next.writingLabel}</p>
      <ol class="writing__list">
        {
          posts.map((post) => (
            <li>
              <a class="post" href={post.href}>
                <time class="post__date" datetime={post.date.toISOString()}>
                  {formatPostDate(post.date)}
                </time>
                <span class="post__title">{post.title}</span>
                {post.description && <span class="post__description">{post.description}</span>}
              </a>
            </li>
          ))
        }
      </ol>
      <p class="writing__links">
        {
          next.links.map((link) => (
            <a class="writing__link" href={link.href}>
              {link.label} <span aria-hidden="true">→</span>
            </a>
          ))
        }
      </p>
    </div>
  </div>
</section>

<style>
  .next .stage {
    display: grid;
    align-items: center;
    padding: var(--bar-height) var(--gutter) 2rem;
  }
  :global(.story-motion) .next__phase {
    grid-area: 1 / 1;
  }
  .next__phase {
    position: relative;
    z-index: 2;
  }

  .next__exploring {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .next__turn {
    margin: 1rem 0 0;
    font-family: var(--font-accent);
    font-style: italic;
    font-size: clamp(1.75rem, 1rem + 2.4vw, 3rem);
    line-height: 1.1;
    color: var(--cyan);
  }
  .exploring {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .exploring li {
    padding: 0.85rem 0;
    border-bottom: 1px solid rgb(152 166 187 / 0.14);
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .writing {
    max-width: 64rem;
    width: 100%;
    justify-self: center;
  }
  .writing__label {
    margin: 0 0 1.5rem;
  }
  .writing__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .post {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    column-gap: 2rem;
    padding: 1.25rem 0;
    border-top: 1px solid rgb(152 166 187 / 0.14);
    text-decoration: none;
    transition: background 0.4s var(--ease-out);
  }
  .post:hover,
  .post:focus-visible {
    background: linear-gradient(90deg, rgb(34 211 238 / 0.06), transparent 70%);
  }
  .post__date {
    grid-row: span 2;
    padding-top: 0.35rem;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .post__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }
  .post:hover .post__title,
  .post:focus-visible .post__title {
    color: var(--cyan);
  }
  .post__description {
    margin-top: 0.4rem;
    color: var(--muted);
  }

  .writing__links {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 2rem 0 0;
  }
  .writing__link {
    font-weight: 500;
    text-decoration: none;
    background: linear-gradient(var(--cyan), var(--cyan)) 0 100% / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease-out);
    padding-bottom: 2px;
  }
  .writing__link:hover,
  .writing__link:focus-visible {
    background-size: 100% 1px;
  }

  :global(html:not(.story-motion)) .next .stage {
    gap: 5rem;
    padding-block: 6rem;
  }

  @media (max-width: 767px) {
    .next__exploring {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .exploring li {
      padding: 0.55rem 0;
      font-size: 0.9375rem;
    }
    .post {
      grid-template-columns: 1fr;
      padding: 0.85rem 0;
    }
    .post__date {
      grid-row: auto;
      padding-top: 0;
    }
    .post__title {
      font-size: 1.125rem;
    }
    .post__description {
      display: none;
    }
  }
</style>
