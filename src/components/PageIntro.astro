---
/* The top of an index page: a small label, the headline, and an optional line under it. */
type Props = { label: string; title: string; lead?: string };

const { label, title, lead } = Astro.props;
---

<header class="intro">
  <p class="label">{label}</p>
  <h1 class="type-headline">{title}</h1>
  {lead && <p class="intro__lead">{lead}</p>}
</header>

<style>
  .intro {
    padding: clamp(3.5rem, 10vw, 7rem) 0 clamp(2.5rem, 6vw, 4rem);
  }
  .label {
    margin: 0 0 1.25rem;
  }
  h1 {
    margin: 0;
    max-width: 18ch;
  }
  .intro__lead {
    margin: 1.5rem 0 0;
    max-width: 40ch;
    font-size: var(--fs-lead);
    color: var(--muted);
  }
</style>
