---
/*
  Layout for the writing and reading pages (indexes and posts). Same design system as
  the home page story, without its motion: the site header, a still glow, and the footer.
*/
import BaseHead from "./BaseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <slot name="meta" />
  </head>
  <body class="site">
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  /* Cross-page view transitions: a post's preview image morphs from the list into the post (lib/posts.ts imageTransitionName). */
  @view-transition {
    navigation: auto;
  }

  body {
    /* Its own stacking context, so the glow below paints over the body's background. */
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  main {
    flex: 1;
    width: 100%;
    max-width: calc(var(--page-width) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* The light from the home page's opening, held still behind the page. */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60rem 36rem at 12% -12%, rgb(59 130 246 / 0.16), transparent 70%),
      radial-gradient(48rem 32rem at 100% 0%, rgb(155 124 255 / 0.1), transparent 70%);
    pointer-events: none;
  }
</style>
