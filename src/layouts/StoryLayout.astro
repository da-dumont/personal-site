---
/*
  Layout for the home page story. Separate from PageLayout: the story has its own
  design system (styles/story.css) and no site header.
*/
import "@fontsource-variable/inter";
import "@fontsource-variable/inter-tight";
import "@fontsource/instrument-serif/400-italic.css";
import "lenis/dist/lenis.css";
import "../styles/story.css";
import Favicon from "./Favicon.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#05070d" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Favicon />
    <slot name="meta" />
    <script is:inline>
      // Before first paint, so animated pieces start hidden instead of flashing.
      // If the story script never finishes, the 4s fallback reveals everything.
      if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        document.documentElement.classList.add("story-motion");
        setTimeout(() => document.documentElement.classList.add("story-ready"), 4000);
      }
    </script>
  </head>
  <body class="story">
    <slot />
  </body>
</html>
